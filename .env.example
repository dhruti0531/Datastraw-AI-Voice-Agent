# ==========================================
# AURA SKINCARE AI VOICE AGENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Primary AI Provider (OpenAI / Groq)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Alternative Provider for high-speed voice
GROQ_API_KEY=your_groq_api_key_here

# Voice / TTS Settings
# Options: "alloy", "shimmer", "nova", "fable", "onyx", "echo", or custom Indian English provider
TTS_VOICE=shimmer
TTS_SPEED=1.0

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
